---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
---

<Layout title={`Photosphere | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Photosphere
      </h1>
      <p class="mb-6">
        Explore this 360-degree panoramic view. You can share this page via the link: <a href="/photosphere" class="text-skin-accent hover:underline">/photosphere</a>
      </p>

      <div id="photosphere-viewer" class="w-full h-[600px] rounded-2xl shadow-lg border border-border"></div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  import { Viewer } from "@photo-sphere-viewer/core";
  import "@photo-sphere-viewer/core/index.css";

  document.addEventListener("astro:page-load", () => {
    const container = document.querySelector("#photosphere-viewer") as HTMLElement;

    if (container) {
      new Viewer({
        container,
        panorama: "/assets/images/PXL_20260918_155150743.PHOTOSPHERE.jpg",
      });
    }
  });
</script>
